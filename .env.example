# =============================================================================
# SWIN AI AGENTIC PROJECT - ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Sao chép file này thành .env và điền các API key của bạn
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API KEYS (Bắt buộc - Chọn ít nhất 1 provider)
# -----------------------------------------------------------------------------

# OpenAI API Key (cho GPT-4, GPT-3.5)
# Đăng ký: https://platform.openai.com/api-keys
# Giá: $0.03/1K tokens (GPT-4), $0.002/1K tokens (GPT-3.5)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (cho Gemini Pro, Gemini Flash)
# Đăng ký: https://makersuite.google.com/app/apikey
# Miễn phí: 60 requests/minute
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXX

# Anthropic API Key (cho Claude 3 Opus, Sonnet, Haiku)
# Đăng ký: https://console.anthropic.com/
# Giá: $0.015/1K tokens (Claude 3)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Groq API Key (fast inference, miễn phí beta)
# Đăng ký: https://console.groq.com/
# Miễn phí trong giai đoạn beta
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Fallback keys
LLM_API_KEY=
GOOGLE_API_KEY=


# -----------------------------------------------------------------------------
# NEWS & DATA APIs (Tùy chọn - Cải thiện phân tích)
# -----------------------------------------------------------------------------

NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=


# -----------------------------------------------------------------------------
# DATABASE & APPLICATION
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=swin_agentic_db
DB_USER=postgres
DB_PASSWORD=

APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost


# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

JWT_SECRET=change-this-secret-in-production
SESSION_SECRET=another-secret-key


# -----------------------------------------------------------------------------
# MONITORING (Tùy chọn)
# -----------------------------------------------------------------------------

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=swin-agentic-project


# -----------------------------------------------------------------------------
# REDIS & CACHE (Tùy chọn)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=