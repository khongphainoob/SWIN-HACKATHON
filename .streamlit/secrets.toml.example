# SWIN Streamlit Secrets
# Copy this file to .streamlit/secrets.toml and configure your actual secrets
# DO NOT commit this file to git

# API Keys
openai_api_key = "your-openai-api-key-here"
gemini_api_key = "your-gemini-api-key-here"
yfinance_api_key = "your-yfinance-api-key-here"
newsapi_key = "your-newsapi-key-here"
anthropic_key = "your-anthropic-api-key-here"

# Admin settings
admin_password = "admin123"
admin_email = "admin@example.com"

# Database settings
database_path = "data/portfolio.db"

# Feature flags
enable_sentiment_analysis = true
enable_ml_forecasting = true
enable_alerts = true
enable_cache = true

# Cache duration in hours
cache_duration_hours = 1

# Thresholds
sentiment_positive_threshold = 0.3
sentiment_negative_threshold = -0.3
forecast_confidence_threshold = 0.6
human_review_required_threshold = 0.8

# News settings
news_limit = 5
max_recommendations = 10
