# =============================================================================
# SWIN AI AGENTIC PROJECT - ENVIRONMENT VARIABLES
# =============================================================================
# Sao chép file này thành .env và điền các API key của bạn
# KHÔNG commit file .env vào Git (đã có trong .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API KEYS (Bắt buộc - Chọn ít nhất 1 provider)
# -----------------------------------------------------------------------------

# OpenAI API Key (cho GPT models)
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API Key (cho Gemini models) 
# Lấy tại: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyARLRfIKvY0xaRFxoSSNRdwN8bML68K-2Y

# Anthropic API Key (cho Claude models)
# Lấy tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq API Key (cho fast inference)
# Lấy tại: https://console.groq.com/
GROQ_API_KEY=

# Fallback API Key (nếu không có key riêng cho provider)
LLM_API_KEY=

# Google API Key (alternative name for Gemini)
GOOGLE_API_KEY=


# -----------------------------------------------------------------------------
# NEWS & DATA APIs (Tùy chọn - Cải thiện chất lượng phân tích)
# -----------------------------------------------------------------------------

# News API Key (cho tin tức tài chính)
# Lấy tại: https://newsapi.org/register
NEWS_API_KEY=

# Alpha Vantage API Key (cho dữ liệu thị trường)
# Lấy tại: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep API Key
# Lấy tại: https://site.financialmodelingprep.com/developer/docs/
FMP_API_KEY=


# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Tùy chọn - Nếu dùng database)
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=swin_agentic_db
DB_USER=postgres
DB_PASSWORD=


# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Environment: development, staging, production
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode
DEBUG=true

# Streamlit server settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost


# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (Nếu cần)
# -----------------------------------------------------------------------------

# JWT Secret for authentication
JWT_SECRET=your-secret-key-change-this-in-production

# Session secret
SESSION_SECRET=another-secret-key-change-this

# API rate limiting
RATE_LIMIT_PER_MINUTE=60


# -----------------------------------------------------------------------------
# CACHE & REDIS (Tùy chọn - Cải thiện performance)
# -----------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# MONITORING & ANALYTICS (Tùy chọn)
# -----------------------------------------------------------------------------

# Langsmith (LangChain tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=swin-agentic-project


# -----------------------------------------------------------------------------
# TESTING
# -----------------------------------------------------------------------------

# Test mode flag
TEST_MODE=false

# Mock API responses in tests
USE_MOCK_RESPONSES=false
